# Aktywnik+ backend — przykład konfiguracji
AKTYWNIK_PUBLIC_ORIGIN=https://aktywnik-plus.vercel.app

# Chmura jest fail-closed. Włączaj dopiero po potwierdzeniu auth + RLS.
AKTYWNIK_CLOUD_SYNC=false
AKTYWNIK_RLS_VERIFIED=false
AUTH_MODE=supabase

# Supabase — zwykłe endpointy użytkownika korzystają wyłącznie z publishable key
# oraz Bearer JWT użytkownika; dostęp do wierszy ogranicza RLS.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Klucze uprzywilejowane NIE są potrzebne do /api/v1/sync, /api/v1/me ani GET /api/v1/classes.
# Jeśli kiedyś pojawią się operacje administracyjne, trzymaj je wyłącznie po stronie serwera
# i w osobnym, kontrolowanym flow.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Alternatywne bezpośrednie PostgreSQL — tylko dla narzędzi administracyjnych/migracji,
# nie dla zwykłych endpointów użytkownika.
DATABASE_URL=

# Aktywnik+ backend — przykład konfiguracji
AKTYWNIK_PUBLIC_ORIGIN=https://aktywnik-plus.vercel.app

# 0.5: Auth może działać wcześniej, ale synchronizacja pozostaje fail-closed.
AKTYWNIK_CLOUD_SYNC=false
AKTYWNIK_RLS_VERIFIED=false
AUTH_MODE=supabase

# Supabase — serwer.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Supabase — klucz publiczny; może być używany w przeglądarce.
SUPABASE_PUBLISHABLE_KEY=

# Zgodność ze starszą konfiguracją serwera; nie używać w kodzie klienta.
SUPABASE_SERVICE_ROLE_KEY=

# Alternatywnie można użyć bezpośredniego połączenia PostgreSQL.
DATABASE_URL=

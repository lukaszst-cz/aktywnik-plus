# Aktywnik+ backend — przykład konfiguracji
AKTYWNIK_PUBLIC_ORIGIN=https://aktywnik-plus.vercel.app

# Synchronizacja pozostaje wyłączona do czasu przejścia migracji i testów RLS.
AKTYWNIK_CLOUD_SYNC=false
AKTYWNIK_RLS_VERIFIED=false
AUTH_MODE=disabled

# Supabase: oba pola są wymagane dla backendu serwerowego.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Alternatywnie można użyć bezpośredniego połączenia PostgreSQL.
DATABASE_URL=

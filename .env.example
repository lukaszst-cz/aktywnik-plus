# Aktywnik+ backend — przykład konfiguracji
AKTYWNIK_PUBLIC_ORIGIN=https://aktywnik-plus.vercel.app

# Cloud sync pozostaje wyłączony do czasu świadomego uruchomienia.
AKTYWNIK_CLOUD_SYNC=false

# RLS w produkcyjnej bazie zostało sprawdzone osobnym preflightem i testem izolacji.
AKTYWNIK_RLS_VERIFIED=false

# Dla trybu chmurowego:
AUTH_MODE=supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Service-role NIE jest potrzebny do zwykłych endpointów użytkownika.
# Operacje administracyjne powinny używać osobnych, kontrolowanych flow/RPC.
SUPABASE_SERVICE_ROLE_KEY=

# Alternatywny bezpośredni Postgres — tylko dla narzędzi administracyjnych/migracji.
DATABASE_URL=
